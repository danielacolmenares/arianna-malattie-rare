# Copia questo file in .env e sostituisci i valori.
# Il file .env non va mai pubblicato.

COMPOSE_PROJECT_NAME=arianna

POSTGRES_DB=arianna
POSTGRES_USER=arianna
POSTGRES_PASSWORD=cambia-questa-password

# Genera con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Genera con: openssl rand -hex 32
MEILI_MASTER_KEY=

# Account dimostrativi del back office (facoltativi)
DEMO_USER_PASSWORD=
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_EDITOR_EMAIL=redattore@example.test
DEMO_VALIDATOR_EMAIL=validatore@example.test
DEMO_DIRECTOR_EMAIL=direttore@example.test
